# Automatic HTTPS for your domain. Caddy provisions and renews a Let's Encrypt
# cert on its own — no manual certbot. The cell serves the agent API only; the app
# people use is Loamz Chat, which talks to it.
{$DOMAIN} {
	encode gzip
	# Stream SSE without buffering so agent responses arrive token-by-token.
	reverse_proxy agent-server:8000 {
		flush_interval -1
	}
}
