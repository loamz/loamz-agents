# Loamz Agents dependency rules. Run: uv run lint-imports --config .importlinter
#
#   loamz.core, loamz.identity, loamz.data   the client libraries (loamz-python repo; HTTP only)
#   loamz.engine                             the storage engines (loamz-data repo: sql, files, vectors, documents, memory)
#   loamz.runtime                            the agent runtime (this repo)
#   loamz.server.agents                      agent hosting (this repo)
#
# The runtime imports no server. It reaches Loamz Data only through the client libraries (the data adapters).
[importlinter]
root_packages =
    loamz
include_external_packages = False
# An import made only for type checking never runs, so it cannot drag a layer along.
exclude_type_checking_imports = True

[importlinter:contract:runtime-imports-no-server]
name = the runtime imports no server (only the data adapters, behind the data extra, use the client)
type = forbidden
source_modules =
    loamz.runtime
forbidden_modules =
    loamz.server
ignore_imports =
    loamz.runtime.data.** -> loamz.data
    loamz.runtime.data.** -> loamz.data.**
    loamz.runtime.data.** -> loamz.core.**

[importlinter:contract:agents-layers]
name = the agent runtime and its hosting layers point downward
type = layers
layers =
    loamz.server.agents.cli
    loamz.server.agents.console | loamz.server.agents.testing
    loamz.server.agents.http
    loamz.server.agents.features
    loamz.server.agents.bootstrap
    loamz.runtime.data | loamz.runtime.toolkit | loamz.runtime.providers
    loamz.runtime.stores
    loamz.runtime.kernel

[importlinter:contract:kernel-concepts]
name = the kernel's concepts only import downward
type = layers
layers =
    loamz.runtime.kernel.wire | loamz.runtime.kernel.events
    loamz.runtime.kernel.agents
    loamz.runtime.kernel.runtime
    loamz.runtime.kernel.middleware
    loamz.runtime.kernel.context
    loamz.runtime.kernel.safety
    loamz.runtime.kernel.ports
    loamz.runtime.kernel.models
    loamz.runtime.kernel.tools
    loamz.runtime.kernel.telemetry
    loamz.runtime.kernel.types
    loamz.runtime.kernel.errors | loamz.runtime.kernel.version | loamz.runtime.kernel.caller

[importlinter:contract:kernel-is-the-engine]
name = the kernel imports nothing of the agent runtime outside it, and no vendor
type = forbidden
source_modules =
    loamz.runtime.kernel
forbidden_modules =
    loamz.runtime.stores
    loamz.runtime.providers
    loamz.runtime.toolkit
    loamz.runtime.testing
    loamz.runtime.evals
    loamz.server
    loamz.data
